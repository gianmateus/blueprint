{
  "name": "blueprint-vscode",
  "displayName": "Blueprint: structural blueprints for your code",
  "description": "See which modules are load-bearing, what breaks if you change a file, where the cracks (circular dependencies) and fire routes are. 2D and 3D.",
  "version": "0.3.0",
  "publisher": "gianmateus",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": { "type": "git", "url": "https://github.com/gianmateus/blueprint" },
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Visualization", "Linters", "Other"],
  "keywords": ["architecture", "dependency graph", "blast radius", "circular dependencies", "security"],
  "main": "./dist/extension.js",
  "activationEvents": ["workspaceContains:**/package.json", "workspaceContains:**/go.mod", "workspaceContains:**/*.py"],
  "contributes": {
    "commands": [
      { "command": "blueprint.open", "title": "Blueprint: Open structural blueprint", "icon": "$(layers)" },
      { "command": "blueprint.reveal", "title": "Blueprint: Show this file on the blueprint" },
      { "command": "blueprint.impact", "title": "Blueprint: What breaks if I change this file?" },
      { "command": "blueprint.refresh", "title": "Blueprint: Redraw" }
    ],
    "menus": {
      "editor/title": [{ "command": "blueprint.open", "group": "navigation" }],
      "editor/context": [
        { "command": "blueprint.impact", "group": "navigation@90" },
        { "command": "blueprint.reveal", "group": "navigation@91" }
      ],
      "explorer/context": [{ "command": "blueprint.impact", "when": "!explorerResourceIsFolder" }]
    },
    "configuration": {
      "title": "Blueprint",
      "properties": {
        "blueprint.pillarThreshold": { "type": "number", "default": 0.15, "description": "Share of the system a module must hold up to count as a pillar." },
        "blueprint.statusBar": { "type": "boolean", "default": true, "description": "Show the structural role of the current file in the status bar." }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "package": "npm run build && npx --yes @vscode/vsce package --no-dependencies"
  }
}
